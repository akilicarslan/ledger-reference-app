{
  "$schema": "../../node_modules/detox/local-cli/utils/configurationSchema.json",
  "testRunner": {
    "args": {
      "$0": "jest",
      "config": "e2e/jest.config.json"
    },
    "jest": {
      "setupTimeout": 240000
    }
  },
  "apps": {
    "ios.release": {
      "type": "ios.app",
      "binaryPath": "ios/build/Build/Products/Release-iphonesimulator/Ledger.app",
      "build": "xcodebuild -workspace ios/Ledger.xcworkspace -scheme Ledger -configuration Release -sdk iphonesimulator -derivedDataPath ios/build -quiet"
    }
  },
  "devices": {
    "simulator": {
      "type": "ios.simulator",
      "device": {
        "type": "iPhone 17 Pro"
      }
    }
  },
  "configurations": {
    "ios.sim.release": {
      "device": "simulator",
      "app": "ios.release"
    }
  }
}
