{
  "name": "@ledger/web",
  "version": "1.0.0",
  "private": true,
  "description": "Ledger web app. React + react-native-web, built with Vite. It uses the same screens as the mobile app.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit -p .",
    "test": "echo \"The shared screens are tested in packages/features.\""
  },
  "dependencies": {
    "@ledger/core": "workspace:*",
    "@ledger/features": "workspace:*",
    "@ledger/ui": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "react-native": "0.86.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
