{
  "name": "@ledger/native-camera",
  "version": "1.0.0",
  "private": true,
  "description": "Nitro native module: take a photo and share its pixels with JavaScript through an ArrayBuffer (no copy). Includes a native PhotoView.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./analysis": "./src/analysis.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "codegen": "nitrogen --logLevel=\"info\"",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "nitrogen": "^0.37.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-modules": "^0.37.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
