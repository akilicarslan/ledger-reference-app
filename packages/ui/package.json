    "@types/react": "~19.3.0",
    "jsdom": "^30.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.4",
    "storybook": "^10.6.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
